{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Backend (ShopERP.Backend)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Solution",
      "program": "${workspaceFolder}/ShopERP.Backend/bin/Debug/net9.0/ShopERP.Backend.dll",
      "args": [],
      "cwd": "${workspaceFolder}/ShopERP.Backend",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7073;http://localhost:5169"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": ".NET Desktop (ShopERP.Rebuild.Desktop)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Solution",
      "program": "${workspaceFolder}/ShopERP.Rebuild/ShopERP.Rebuild.Desktop/bin/Debug/net9.0-windows/ShopERP.Rebuild.Desktop.exe",
      "args": [],
      "cwd": "${workspaceFolder}/ShopERP.Rebuild/ShopERP.Rebuild.Desktop",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": ".NET Attach (select process)",
      "type": "coreclr",
      "request": "attach"
    }
  ],
  "compounds": [
    {
      "name": "Debug Backend + Desktop",
      "configurations": [
        ".NET Backend (ShopERP.Backend)",
        ".NET Desktop (ShopERP.Rebuild.Desktop)"
      ],
      "stopAll": true
    }
  ]
}
