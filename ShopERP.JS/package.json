{
  "name": "shoperp-js",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev -w apps/api\" \"npm run dev -w apps/desktop\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:desktop": "npm run dev -w apps/desktop",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
