generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

model Shop {
  id              String                @id @default(cuid())
  name            String
  email           String?
  phone           String?
  users           User[]
  products        Product[]
  batches         ProductBatch[]
  suppliers       Supplier[]
  doctors         Doctor[]
  salesBills      SalesBill[]
  purchases       PurchaseBill[]
  payments        PaymentEntry[]
  salesReturns    SalesReturn[]
  purchaseReturns PurchaseReturn[]
  customerLedgers CustomerLedgerEntry[]
  supplierLedgers SupplierLedgerEntry[]
  purchaseOrders  PurchaseOrder[]
  backupLogs      BackupLog[]
  syncLogs        SyncLog[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model Doctor {
  id             String    @id @default(cuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  visitCount     Int       @default(0)
  lastVisitAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shopId, normalizedName])
  @@index([shopId, updatedAt])
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(STAFF)
  displayName  String?
  lastLoginUtc DateTime?
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id                 String              @id @default(cuid())
  shopId             String
  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name               String
  sku                String?
  hsn                String?
  unit               String?
  purchaseRate       Float               @default(0)
  saleRate           Float               @default(0)
  gstPercent         Float               @default(0)
  stockQty           Float               @default(0)
  expiryDate         DateTime?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  salesItems         SalesItem[]
  purchaseItems      PurchaseItem[]
  purchaseOrderItems PurchaseOrderItem[]
  batches            ProductBatch[]

  @@index([shopId])
}

model ProductBatch {
  id            String         @id @default(cuid())
  shopId        String
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNo       String
  expiryDate    DateTime?
  purchasePrice Float          @default(0)
  mrp           Float          @default(0)
  quantity      Float          @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  salesItems    SalesItem[]
  purchaseItems PurchaseItem[]

  @@unique([shopId, productId, batchNo])
  @@index([shopId, quantity])
}

model Supplier {
  id             String                @id @default(cuid())
  shopId         String
  shop           Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  address        String?
  gstin          String?
  drugLicense    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  purchases      PurchaseBill[]
  purchaseOrders PurchaseOrder[]
  payments       PaymentEntry[]
  ledgerEntries  SupplierLedgerEntry[]

  @@index([shopId])
}

model SalesBill {
  id            String         @id @default(cuid())
  shopId        String
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoiceNo     String
  customerName  String?
  doctorName    String?
  billDate      DateTime       @default(now())
  subtotal      Float          @default(0)
  taxTotal      Float          @default(0)
  discountTotal Float          @default(0)
  grandTotal    Float          @default(0)
  paidTotal     Float          @default(0)
  dueTotal      Float          @default(0)
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         SalesItem[]
  payments      PaymentEntry[]
  returns       SalesReturn[]

  @@unique([shopId, invoiceNo])
  @@index([shopId, billDate])
}

model SalesItem {
  id         String        @id @default(cuid())
  billId     String
  bill       SalesBill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId    String?
  batch      ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantity   Float
  unitRate   Float
  costRate   Float         @default(0)
  discount   Float         @default(0)
  gstPercent Float         @default(0)
  lineTotal  Float
}

model PurchaseBill {
  id            String           @id @default(cuid())
  shopId        String
  shop          Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  billNo        String
  supplierId    String?
  supplier      Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  billDate      DateTime         @default(now())
  subtotal      Float            @default(0)
  taxTotal      Float            @default(0)
  discountTotal Float            @default(0)
  grandTotal    Float            @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  items         PurchaseItem[]
  payments      PaymentEntry[]
  returns       PurchaseReturn[]

  @@unique([shopId, billNo])
  @@index([shopId, billDate])
}

model PurchaseItem {
  id         String        @id @default(cuid())
  billId     String
  bill       PurchaseBill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId    String?
  batch      ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantity   Float
  unitRate   Float
  discount   Float         @default(0)
  gstPercent Float         @default(0)
  lineTotal  Float
}

model NotificationEntry {
  id        String   @id @default(cuid())
  shopId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([shopId, read])
}

model PaymentEntry {
  id             String        @id @default(cuid())
  shopId         String
  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  paymentDate    DateTime      @default(now())
  amount         Float
  method         String
  referenceNo    String?
  note           String?
  customerName   String?
  supplierId     String?
  supplier       Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  salesBillId    String?
  salesBill      SalesBill?    @relation(fields: [salesBillId], references: [id], onDelete: SetNull)
  purchaseBillId String?
  purchaseBill   PurchaseBill? @relation(fields: [purchaseBillId], references: [id], onDelete: SetNull)
  createdById    String?
  createdAt      DateTime      @default(now())

  @@index([shopId, paymentDate])
}

model SalesReturn {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  salesBillId String
  salesBill   SalesBill @relation(fields: [salesBillId], references: [id], onDelete: Cascade)
  returnDate  DateTime  @default(now())
  amount      Float
  reason      String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([shopId, returnDate])
}

model PurchaseReturn {
  id             String       @id @default(cuid())
  shopId         String
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purchaseBillId String
  purchaseBill   PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  returnDate     DateTime     @default(now())
  amount         Float
  reason         String?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([shopId, returnDate])
}

model CustomerLedgerEntry {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerName String
  entryDate    DateTime @default(now())
  debit        Float    @default(0)
  credit       Float    @default(0)
  note         String?
  salesBillId  String?
  createdAt    DateTime @default(now())

  @@index([shopId, customerName, entryDate])
}

model SupplierLedgerEntry {
  id             String    @id @default(cuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName   String
  entryDate      DateTime  @default(now())
  debit          Float     @default(0)
  credit         Float     @default(0)
  note           String?
  purchaseBillId String?
  createdAt      DateTime  @default(now())

  @@index([shopId, supplierName, entryDate])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  shopId      String
  shop        Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderNo     String
  supplierId  String?
  supplier    Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orderDate   DateTime            @default(now())
  status      String              @default("DRAFT")
  subtotal    Float               @default(0)
  taxTotal    Float               @default(0)
  grandTotal  Float               @default(0)
  notes       String?
  items       PurchaseOrderItem[]
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([shopId, orderNo])
  @@index([shopId, orderDate])
}

model PurchaseOrderItem {
  id         String        @id @default(cuid())
  orderId    String
  order      PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Float
  unitRate   Float
  discount   Float         @default(0)
  gstPercent Float         @default(0)
  lineTotal  Float
}

model BackupLog {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status      String
  destination String
  message     String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([shopId, createdAt])
}

model SyncLog {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  provider    String    @default("mysql")
  status      String
  message     String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdById String?

  @@index([shopId, startedAt])
}
