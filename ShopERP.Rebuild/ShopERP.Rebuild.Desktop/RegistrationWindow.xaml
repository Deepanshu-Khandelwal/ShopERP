<Window x:Class="ShopERP.Rebuild.Desktop.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShopERP.Rebuild.Desktop.Converters"
        Title="MediCore Nexus // Registration"
        Height="800"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <local:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="20" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT ART PANEL -->
            <Border Grid.Column="0" Background="{StaticResource AccentGradient}" CornerRadius="20,0,0,20">
                <Grid>
                    <Canvas Opacity="0.1">
                        <Ellipse Width="500" Height="500" Fill="White" Canvas.Left="-200" Canvas.Top="-200" />
                        <Path Fill="White" Data="M 100,100 L 200,100 L 200,200 L 100,200 Z" Canvas.Right="40" Canvas.Bottom="100" />
                    </Canvas>
                    
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="60">
                        <Border Width="80" Height="80" CornerRadius="24" Background="#30FFFFFF" HorizontalAlignment="Left" Margin="0,0,0=">
                             <TextBlock Text="Rx" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="JOIN MEDICORE" Foreground="White" FontSize="40" FontWeight="ExtraBold" Margin="0,32,0,8" />
                        <TextBlock Text="Secure Medical Infrastructure Node" Foreground="White" FontSize="16" FontWeight="Medium" Opacity="0.8" Margin="0,0,0,40" />
                        
                        <Border Background="#20FFFFFF" CornerRadius="16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Protocol Requirements:" Foreground="White" FontWeight="Bold" Margin="0,0,0,12" />
                                <TextBlock Text="• Valid Clinical ID Required" Foreground="White" FontSize="13" Margin="0,4"/>
                                <TextBlock Text="• Cryptographic Password Standards" Foreground="White" FontSize="13" Margin="0,4"/>
                                <TextBlock Text="• Node Encryption Enabled" Foreground="White" FontSize="13" Margin="0,4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT FORM PANEL -->
            <Border Grid.Column="1" Background="{StaticResource BrushNavSurface}" CornerRadius="0,20,20,0" Padding="50">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="REQUEST ACCESS" Foreground="{StaticResource BrushPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="Create Credentials" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,24" />

                        <!-- SUCCESS -->
                        <Border Background="#1510B981" CornerRadius="8" Padding="12" Margin="0,0,0,20" 
                                Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource BrushPrimary}" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <!-- USERNAME -->
                        <TextBlock Text="Desired System ID (Username)" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                        <!-- PASSWORD -->
                        <TextBlock Text="Access Key (Password)" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                        <PasswordBox x:Name="PasswordInput" Margin="0,0,0,20" />

                        <!-- CONFIRM PASSWORD -->
                        <TextBlock Text="Verify Access Key" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                        <PasswordBox x:Name="ConfirmPasswordInput" Margin="0,0,0,20" />

                        <!-- ERROR -->
                        <Border Background="#15EF4444" CornerRadius="8" Padding="12" Margin="0,0,0,24" 
                                Visibility="{Binding Error, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource BrushDanger}" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <!-- ACTIONS -->
                        <Button Content="REGISTER NODE" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Height="54" 
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                Click="OnRegisterClick" />

                        <Button Content="BACK TO GATEWAY" 
                                Style="{StaticResource LinkButtonStyle}" 
                                HorizontalAlignment="Center" 
                                Margin="0,24,0,0"
                                Click="OnSignInClick" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Close Button -->
            <Button Content="✕" Width="40" Height="40" Background="Transparent" Foreground="White" 
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="OnCloseClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
