<Window x:Class="ShopERP.Rebuild.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MediCore ERP // Advanced Medical Management"
        Height="900"
        Width="1600"
        MinWidth="1100"
        MinHeight="750"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="16" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackground}" CornerRadius="16" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" /> <!-- Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Content -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BrushNavSurface}" CornerRadius="16,0,0,16" BorderBrush="{StaticResource BrushNavBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Brand -->
                        <RowDefinition Height="*" />    <!-- Nav -->
                        <RowDefinition Height="Auto" /> <!-- User -->
                    </Grid.RowDefinitions>

                    <!-- Branding -->
                    <StackPanel Grid.Row="0" Margin="24,32,24,32" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="Rx" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MediCore ERP" Foreground="White" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Nexus OS // V2.0" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Navigation -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NavigationSections}" Margin="12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,24">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontWeight="Bold" Margin="12,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}"
                                                            Style="{StaticResource SidebarButtonStyle}"
                                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Route}"
                                                            IsEnabled="{Binding IsEnabled}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- User Info & Logout -->
                    <Border Grid.Row="2" Background="#0AFFFFFF" CornerRadius="0,0,0,16" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource BrushSurfaceElevated}" Grid.Column="0">
                                    <TextBlock Text="A" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding UserBadge}" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="System Administrator" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Logout" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Foreground="{StaticResource BrushDanger}" Click="OnLogoutClick" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" /> <!-- Header -->
                    <RowDefinition Height="*" />  <!-- Content -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Margin="24,16,24,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPage.Title}" FontSize="24" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="MediCore System Workspace" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Dynamic Status -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#10FFFFFF" CornerRadius="10" Padding="12,8" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,1" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SyncStatus}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button Content="Refresh" Style="{StaticResource ActionButtonStyle}" Command="{Binding RunSyncNowCommand}" IsEnabled="{Binding IsAdmin}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content -->
                <Border Grid.Row="1" Style="{StaticResource ShellContentStyle}" Margin="24" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding CurrentPage}" Padding="32" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
