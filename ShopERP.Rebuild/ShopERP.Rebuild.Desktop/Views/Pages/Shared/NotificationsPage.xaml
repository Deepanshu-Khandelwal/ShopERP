<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Shared.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="System Alerts &amp; Health" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Real-time monitoring of clinical risks, stock expirations, and node synchronization events." Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </Border>

        <!-- Alerts Content -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Notifications}" Margin="20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0AFFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40" Height="40" CornerRadius="20" Background="#15EF4444" VerticalAlignment="Top">
                                            <TextBlock Text="!" Foreground="{StaticResource BrushDanger}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="20,0">
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=Timestamp: {0:dd MMM yyyy HH:mm}}" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,8,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Clear" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center" Command="{Binding DataContext.MarkAsReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="1" Background="#0AFFFFFF" Padding="20,12" CornerRadius="0,0,16,16">
                    <Grid>
                        <TextBlock Text="Total Active Alerts: 0" x:Name="AlertCount" Foreground="{StaticResource BrushTextSecondary}" />
                        <Button Content="Dismiss All Alerts" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Right" Foreground="{StaticResource BrushDanger}" Command="{Binding ClearAllCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>