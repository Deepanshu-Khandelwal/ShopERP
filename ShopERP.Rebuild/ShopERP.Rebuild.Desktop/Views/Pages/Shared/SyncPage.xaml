<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Shared.SyncPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
        <Border Style="{StaticResource ModernCard}" Padding="40">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="80" Height="80" CornerRadius="40" Background="#1510B981" Margin="0,0,0,32">
                    <TextBlock Text="🔄" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                
                <TextBlock Text="Cloud Synchronization Engine" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="MediCore Secure Sync Protocol v5.2" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,32" />

                <Border Background="#0AFFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,32" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="System Health" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="{Binding HealthStatus}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressValue}" Height="6" Background="#20FFFFFF" Foreground="{StaticResource BrushPrimary}" BorderThickness="0" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Button Content="FORCE NODE SYNCHRONIZATION" Style="{StaticResource PrimaryButtonStyle}" Height="54" Width="300" Command="{Binding SyncCommand}" />
                <TextBlock Text="Last verified: 2 minutes ago" Foreground="{StaticResource BrushTextMuted}" FontSize="11" HorizontalAlignment="Center" Margin="0,20,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
