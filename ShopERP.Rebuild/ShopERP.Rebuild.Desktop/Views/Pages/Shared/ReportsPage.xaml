<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Shared.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Clinical Analytics &amp; Reports" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Aggregate data insights and operational performance audits." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <DatePicker SelectedDate="{Binding StartDate}" Margin="0,0,12,0" Width="150" />
                    <DatePicker SelectedDate="{Binding EndDate}" Margin="0,0,12,0" Width="150" />
                    <Button Content="GENERATE AUDIT" Style="{StaticResource PrimaryButtonStyle}" Width="160" Height="42" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Reports Dashboard -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="3" Margin="0,0,0,24">
                    <Border Style="{StaticResource ModernCard}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="Net Pharmaceutical Sales" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding TotalSales, StringFormat=INR {0:N2}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ModernCard}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="Clinical Gross Margin" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding TotalProfit, StringFormat=INR {0:N2}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ModernCard}">
                        <StackPanel>
                            <TextBlock Text="Taxable Liability (GST)" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding NetTax, StringFormat=INR {0:N2}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <TextBlock Text="Medication Sales Performance" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                        <DataGrid ItemsSource="{Binding SalesData}" AutoGenerateColumns="False" IsReadOnly="True" Height="400">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medication" Binding="{Binding ProductName}" Width="2*" />
                                <DataGridTextColumn Header="Total Units Sold" Binding="{Binding TotalQuantity}" Width="*" />
                                <DataGridTextColumn Header="Calculated Revenue" Binding="{Binding TotalRevenue, StringFormat=N2}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
