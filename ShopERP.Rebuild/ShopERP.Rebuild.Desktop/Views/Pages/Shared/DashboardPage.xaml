<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Shared.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,32">
            <!-- Hero Section -->
            <Border Style="{StaticResource ModernCard}" Background="{StaticResource AccentGradient}" Height="180" Margin="0,0,0,32">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Nexus Clinical Node Status" Foreground="White" FontSize="14" FontWeight="Bold" Opacity="0.8" Margin="0,0,0,8" />
                        <TextBlock Text="Intelligent Health &amp; Inventory Management" Foreground="White" FontSize="28" FontWeight="ExtraBold" Margin="0,0,0,12" />
                        <TextBlock Text="System operational. All medical procurement channels are active and synchronized." Foreground="White" FontSize="14" Opacity="0.9" TextWrapping="Wrap" />
                    </StackPanel>
                    
                    <Border Grid.Column="1" VerticalAlignment="Center" Background="#30FFFFFF" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Active Alerts" Foreground="White" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ExpiryAlerts}" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" />
                            <Button Content="Sync Records" Style="{StaticResource ActionButtonStyle}" Background="White" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" Command="{Binding GenerateNotificationsCommand}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Key Metrics Grid -->
            <UniformGrid Columns="4" Margin="0,0,0,32">
                <Border Style="{StaticResource ModernCard}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Sales Volume" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding TotalSales, StringFormat=INR {0:N2}}" FontSize="22" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="+12.5% vs yesterday" FontSize="11" Foreground="{StaticResource BrushPrimary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ModernCard}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Clinical Margin" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding TotalProfit, StringFormat=INR {0:N2}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" />
                        <TextBlock Text="Operational healthy" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ModernCard}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Critical Stock" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding LowStockAlerts}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" />
                        <TextBlock Text="Stock replenishment required" FontSize="11" Foreground="{StaticResource BrushDanger}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ModernCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Expiry Watch" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ExpiryAlerts}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" />
                        <TextBlock Text="Review medication logs" FontSize="11" Foreground="{StaticResource BrushWarning}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Detailed Analysis Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <!-- Performance Table -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,24,0">
                    <StackPanel>
                        <TextBlock Text="Highest Distribution Medications" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                        <DataGrid ItemsSource="{Binding TopProducts}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Height="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medication / Item" Binding="{Binding ProductName}" Width="2*" />
                                <DataGridTextColumn Header="Throughput (Qty Sold)" Binding="{Binding QuantitySold}" Width="*" />
                                <DataGridTextColumn Header="Utilization Rating" Binding="{Binding Percentage, StringFormat={}{0}%}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- System Logs / Info -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <TextBlock Text="System Insight" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                        <Border Background="#10FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Node Health: 98%" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" />
                                <TextBlock Text="Database synchronized. 42 files updated in last cycle." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="#10FFFFFF" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Audit Complete" Foreground="{StaticResource BrushSecondary}" FontWeight="Bold" />
                                <TextBlock Text="Financial logs for current quarter are verified." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
