<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Lists.StockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Inventory Levels" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Live monitoring of pharmaceutical stock distribution and replenishment needs." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                     <Border Background="#10FFFFFF" CornerRadius="10" Padding="12,0" Margin="0,0,12,0" Width="300" Height="42" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="Search inventory..." Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" IsHitTestVisible="False" 
                                       Visibility="{Binding SearchText.Length, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" Margin="4,0,0,0" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0" />
                        </Grid>
                    </Border>
                    <Button Content="ORDER REFRESH" Style="{StaticResource ActionButtonStyle}" Width="150" Height="42" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid ItemsSource="{Binding FilteredItems}"
                          AutoGenerateColumns="False"
                          RowStyle="{StaticResource DataGridRowHoverStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#1510B981" HorizontalAlignment="Center">
                                        <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Medication" Binding="{Binding ProductName}" Width="2*" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="*" />
                        <DataGridTemplateColumn Header="Current Level" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StockQty}" FontWeight="Bold" Foreground="White" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Safety Threshold" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MinStockLevel}" Foreground="{StaticResource BrushTextSecondary}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Health Status" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1510B981" CornerRadius="8" Padding="12,4" HorizontalAlignment="Left">
                                        <TextBlock Text="OPTIMAL" Foreground="{StaticResource BrushPrimary}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer Info -->
                <Border Grid.Row="1" Background="#0AFFFFFF" Padding="16,8" CornerRadius="0,0,16,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Node Inventory Synchronization Active" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>