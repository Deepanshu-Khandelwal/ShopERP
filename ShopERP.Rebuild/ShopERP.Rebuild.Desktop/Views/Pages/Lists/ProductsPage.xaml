<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Lists.ProductsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Pharmacy Records" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Centralized inventory and medication procurement log." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                     <Border Background="#10FFFFFF" CornerRadius="10" Padding="12,0" Margin="0,0,12,0" Width="300" Height="42" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="Search medications..." Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" IsHitTestVisible="False" 
                                       Visibility="{Binding SearchText.Length, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" Margin="4,0,0,0" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0" />
                        </Grid>
                    </Border>
                    <Button Content="+ NEW ENTRY" Style="{StaticResource PrimaryButtonStyle}" Width="160" Height="42"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="ProductsForm" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid ItemsSource="{Binding FilteredItems}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          RowStyle="{StaticResource DataGridRowHoverStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#1510B981" HorizontalAlignment="Center">
                                        <TextBlock Text="Rx" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Medication" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Generic Name" Binding="{Binding GenericName}" Width="1.5*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="*" />
                        <DataGridTextColumn Header="Expiration Date" Binding="{Binding Expiry, StringFormat={}{0:dd MMM yyyy}}" Width="*" />
                        <DataGridTemplateColumn Header="Inventory Level" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StockQty}" FontWeight="Bold" />
                                        <TextBlock Text=" units" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="4,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="MRP (INR)" Binding="{Binding Mrp, StringFormat=N2}" Width="*" />
                        <DataGridTemplateColumn Header="Management" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                                        <Button Content="Edit" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Void" Style="{StaticResource DeleteActionButtonStyle}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="EmptyState" Style="{StaticResource EmptyStateCardStyle}" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="No Local Records" Style="{StaticResource EmptyStateTitleStyle}" />
                        <TextBlock Text="The medication registry is currently empty. Initialize via procurement node." Style="{StaticResource EmptyStateMessageStyle}" />
                        <Button Content="Add First Medication" Style="{StaticResource EmptyStateActionButtonStyle}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="ProductsForm" />
                    </StackPanel>
                </Border>
                
                <!-- Footer Info -->
                <Border Grid.Row="1" Background="#0AFFFFFF" Padding="16,8" CornerRadius="0,0,16,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RecordCount, StringFormat=Total Active Records: {0}}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" Foreground="{StaticResource BrushPrimary}" FontSize="11" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
