<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Lists.LedgersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Financial Ledger" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Comprehensive transactional audit trail for clinical operations." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <DatePicker SelectedDate="{Binding StartDate}" Margin="0,0,12,0" Width="150" />
                    <DatePicker SelectedDate="{Binding EndDate}" Margin="0,0,12,0" Width="150" />
                    <Button Content="SYNC LEDGER" Style="{StaticResource ActionButtonStyle}" Width="150" Height="42" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid ItemsSource="{Binding FilteredItems}"
                          AutoGenerateColumns="False"
                          RowStyle="{StaticResource DataGridRowHoverStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Date, StringFormat={}{0:dd MMM yyyy}}" Width="*" />
                        <DataGridTextColumn Header="Node / Entity" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Classification" Binding="{Binding Type}" Width="*" />
                        <DataGridTemplateColumn Header="Debit (-)" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Debit, StringFormat=N2}" Foreground="{StaticResource BrushDanger}" HorizontalAlignment="Right" Margin="0,0,20,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Credit (+)" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Credit, StringFormat=N2}" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Right" Margin="0,0,20,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Running Balance" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Balance, StringFormat=N2}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" Margin="0,0,20,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer Summary -->
                <Border Grid.Row="1" Background="#0AFFFFFF" Padding="20,12" CornerRadius="0,0,16,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ledger Health: Verified" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Final Settlement: " Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalBalance, StringFormat=INR {0:N2}}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>