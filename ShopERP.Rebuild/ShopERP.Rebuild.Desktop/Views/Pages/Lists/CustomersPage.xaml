<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Lists.CustomersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Patient Database" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Secure repository of patient history and classification." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                     <Border Background="#10FFFFFF" CornerRadius="10" Padding="12,0" Margin="0,0,12,0" Width="300" Height="42" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="Search patient names..." Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" IsHitTestVisible="False" 
                                       Visibility="{Binding SearchText.Length, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" Margin="4,0,0,0" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0" />
                        </Grid>
                    </Border>
                    <Button Content="+ ADD PATIENT" Style="{StaticResource PrimaryButtonStyle}" Width="160" Height="42"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="CustomersForm" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid ItemsSource="{Binding FilteredItems}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          RowStyle="{StaticResource DataGridRowHoverStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#150EA5E9" HorizontalAlignment="Center">
                                        <TextBlock Text="👤" Foreground="{StaticResource BrushSecondary}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Patient Name" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Identification (ID)" Binding="{Binding CustomerId}" Width="*" />
                        <DataGridTextColumn Header="Contact Signal" Binding="{Binding Phone}" Width="*" />
                        <DataGridTextColumn Header="Registry Location" Binding="{Binding Address}" Width="1.5*" />
                        <DataGridTemplateColumn Header="Operations" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                                        <Button Content="View File" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Archive" Style="{StaticResource DeleteActionButtonStyle}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer Info -->
                <Border Grid.Row="1" Background="#0AFFFFFF" Padding="16,8" CornerRadius="0,0,16,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RecordCount, StringFormat=Total Registered Patients: {0}}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" Foreground="{StaticResource BrushSecondary}" FontSize="11" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
