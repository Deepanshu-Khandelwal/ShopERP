<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Lists.PurchaseOrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel>
                    <TextBlock Text="Medication Purchase Orders" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Forward planning and procurement requests for clinical stock replenishment." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                     <Border Background="#10FFFFFF" CornerRadius="10" Padding="12,0" Margin="0,0,12,0" Width="300" Height="42" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="Search orders..." Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" IsHitTestVisible="False" 
                                       Visibility="{Binding SearchText.Length, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" Margin="4,0,0,0" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0" />
                        </Grid>
                    </Border>
                    <Button Content="+ NEW ORDER" Style="{StaticResource PrimaryButtonStyle}" Width="160" Height="42"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="PurchaseOrdersForm" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid ItemsSource="{Binding FilteredItems}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          RowStyle="{StaticResource DataGridRowHoverStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#150EA5E9" HorizontalAlignment="Center">
                                        <TextBlock Text="📅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="*" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Supplier Entity" Binding="{Binding SupplierName}" Width="1.5*" />
                        <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, StringFormat={}{0:dd MMM yyyy}}" Width="*" />
                        <DataGridTemplateColumn Header="Est. Amount" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat=INR {0:N2}}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Operations" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                                        <Button Content="Details" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Void" Style="{StaticResource DeleteActionButtonStyle}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Background="#0AFFFFFF" Padding="16,8" CornerRadius="0,0,16,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Procurement pipeline is active." Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
