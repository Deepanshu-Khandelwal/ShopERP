<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Forms.ReturnsForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Content="← BACK" Style="{StaticResource ActionButtonStyle}" Width="90" Height="36" VerticalAlignment="Top"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="ReturnsList" />
                
                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="Reverse Logistics Terminal (Returns)" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Process medication returns, recalls, and clinical credit clearing." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Line Entry -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Return Entry" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20" />
                        
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Active Batch" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Batches}" DisplayMemberPath="BatchNo" SelectedValuePath="Id" SelectedValue="{Binding SelectedBatchId}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Qty" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LineQty}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Credit Rate" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LineRate}" />
                            </StackPanel>
                            
                            <Button Grid.Column="6" Content="ADD TO RECORD" Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="16,0" VerticalAlignment="Bottom" Command="{Binding AddLineCommand}" />
                        </Grid>

                        <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Height="400" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medication Item" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80" />
                                <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="100" />
                                <DataGridTemplateColumn Header="Credit Total" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Amount, StringFormat=N2}" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Style="{StaticResource DeleteActionButtonStyle}" Height="22" Width="22" Padding="0" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Actions Sidebar -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Return Metadata" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20" />
                        
                        <TextBlock Text="Return Mode" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding ReturnModes}" SelectedItem="{Binding SelectedMode}" Margin="0,0,0,16" />

                        <TextBlock Text="Return Identifier (ID)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ReturnNo}" Margin="0,0,0,16" />

                        <TextBlock Text="Verification Date" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                        <DatePicker SelectedDate="{Binding ReturnDate}" Margin="0,0,0,16" />

                        <TextBlock Text="Target Entity (Patient/Supplier)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedCustomerId}" Visibility="{Binding SelectedMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Patient}" Margin="0,0,0,16" />
                        <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedSupplierId}" Visibility="{Binding SelectedMode, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Supplier}" Margin="0,0,0,16" />

                        <TextBlock Text="Reason for Clinical Return" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <Border Background="#10EF4444" CornerRadius="12" Padding="16" Margin="0,12,0,20">
                            <StackPanel>
                                <TextBlock Text="TOTAL RECALL VALUE" Foreground="{StaticResource BrushDanger}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="{Binding Total, StringFormat=INR {0:N2}}" Foreground="{StaticResource BrushTextPrimary}" FontSize="20" FontWeight="ExtraBold" />
                            </StackPanel>
                        </Border>

                        <Button Content="FINALIZE RETURN" Style="{StaticResource PrimaryButtonStyle}" Height="54" Margin="0,0,0,12" Command="{Binding SaveReturnCommand}" />
                        <Button Content="VOID LOG" Style="{StaticResource DeleteActionButtonStyle}" Height="40"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="ReturnsList" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
