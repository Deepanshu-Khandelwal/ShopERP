<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Forms.PurchasesForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Content="← BACK" Style="{StaticResource ActionButtonStyle}" Width="90" Height="36" VerticalAlignment="Top"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="PurchasesList" />
                
                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="Clinical Procurement" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Register bulk pharmacological inventory acquisitions." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Main Procurement Area -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Procurement Core Details" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,24" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Supplier Entity Name" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                                <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Procurement Slip ID (Bill No)" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                                <TextBox Text="{Binding BillNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Add Procurement Line" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Medication Name" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LineItemName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Acquisition Qty" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Purchase Cost" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LineUnitPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Assigned Batch No" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LineBatchNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Expiration Date" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <DatePicker SelectedDate="{Binding LineExpiryDate}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4">
                                <TextBlock Text="MRP (Retail)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LineMrp, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            
                            <Button Grid.Column="6" Content="ADD ENTRY" Style="{StaticResource PrimaryButtonStyle}" Height="42" VerticalAlignment="Bottom" Padding="20,0" Command="{Binding AddLineCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DataGrid -->
                <Border Style="{StaticResource ModernCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Height="300" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medication Item" Binding="{Binding ItemName}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="100" />
                                <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitPrice}" Width="120" />
                                <DataGridTemplateColumn Header="Line Total" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LineTotal, StringFormat=N2}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Style="{StaticResource DeleteActionButtonStyle}" Height="24" Width="24" Padding="0" Command="{Binding DataContext.RemoveSelectedLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1" Background="#0AFFFFFF" Padding="24,16" CornerRadius="0,0,16,16">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total Expenditure Estimation" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CalculatedTotal, StringFormat=INR {0:N2}}" Foreground="{StaticResource BrushTextPrimary}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Sidebar -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Node Finalization" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20" />
                        
                        <TextBlock Text="Acquisition Status" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,8" />
                        <TextBox Text="{Binding PurchaseStatus, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24" />

                        <Button Content="FINALIZE PROCUREMENT" Style="{StaticResource PrimaryButtonStyle}" Height="54" Margin="0,0,0,12" Command="{Binding SaveCommand}" />
                        <Button Content="CLEAR BUFFER" Style="{StaticResource ActionButtonStyle}" Height="40" Margin="0,0,0,12" Command="{Binding NewFormCommand}" />
                        <Button Content="VOID LOG" Style="{StaticResource DeleteActionButtonStyle}" Height="40"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="PurchasesList" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCard}" Background="#150EA5E9">
                    <StackPanel>
                        <TextBlock Text="Supply Chain Health" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="Cloud nodes are monitoring this procurement. Inventory levels will increase immediately upon successful finalization." Foreground="#D0E9F5" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
