<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Forms.SalesForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Content="← BACK" Style="{StaticResource ActionButtonStyle}" Width="90" Height="36" VerticalAlignment="Top"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="SalesList" />
                
                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="Medication Dispensing" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Execute pharmaceutical distribution and patient billing." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Main Dispensing Area -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Dispensing Entry" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,24" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Select Medication" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding AvailableProducts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProductId}" UseLayoutRounding="True" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Active Batch" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding AvailableBatches}" DisplayMemberPath="BatchNo" SelectedValuePath="Id" SelectedValue="{Binding SelectedBatchId}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,20,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Units (Qty)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unit Rate" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LineUnitPrice, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Discount" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LineDiscountAmount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            
                            <Button Grid.Column="6" Content="ADD TO DISPENSE" Style="{StaticResource PrimaryButtonStyle}" Height="42" VerticalAlignment="Bottom" Padding="20,0" Command="{Binding AddLineCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DataGrid and Totals -->
                <Border Style="{StaticResource ModernCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Height="300" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medication" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80" />
                                <DataGridTextColumn Header="Rate" Binding="{Binding UnitPrice}" Width="100" />
                                <DataGridTextColumn Header="Disc." Binding="{Binding DiscountAmount}" Width="80" />
                                <DataGridTemplateColumn Header="Net Amount" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LineTotal, StringFormat=N2}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Style="{StaticResource DeleteActionButtonStyle}" Height="24" Width="24" Padding="0" Command="{Binding DataContext.RemoveSelectedLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1" Background="#0AFFFFFF" Padding="24,16" CornerRadius="0,0,16,16">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Operational Summary" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="ESTIMATED TOTAL: " Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" FontWeight="Bold" />
                                    <TextBlock Text="{Binding CalculatedTotal, StringFormat=INR {0:N2}}" Foreground="White" FontSize="20" FontWeight="ExtraBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Sidebar -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Nexus Operations" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20" />
                        
                        <TextBlock Text="Dispensing ID" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,8" />
                        <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24" />

                        <Button Content="FINALIZE DISPENSING" Style="{StaticResource PrimaryButtonStyle}" Height="54" Margin="0,0,0,12" Command="{Binding SaveCommand}" />
                        <Button Content="RESET TERMINAL" Style="{StaticResource ActionButtonStyle}" Height="40" Margin="0,0,0,12" Command="{Binding NewFormCommand}" />
                        <Button Content="VOID LOG" Style="{StaticResource DeleteActionButtonStyle}" Height="40"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="SalesList" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModernCard}" Background="#1510B981">
                    <StackPanel>
                        <TextBlock Text="System Verification" Foreground="White" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="Distribution nodes are active. Inventory will be automatically deducted upon finalization." Foreground="#D2F7EC" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
