<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Forms.CustomersForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Content="← BACK" Style="{StaticResource ActionButtonStyle}" Width="90" Height="36" VerticalAlignment="Top"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="CustomersList" />
                
                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="Patient Registration" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Collect primary identification and clinical contact data." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Main Fields -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,24,0">
                <StackPanel>
                    <TextBlock Text="Patient Profiles" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,24" />
                    
                    <TextBlock Text="Legal Name of Patient" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mobile Signal (Phone)" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Secure Email Address" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Residential Location (Address)" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,24" />

                    <TextBlock Text="Clinical Background (Medical History)" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                    <TextBox Text="{Binding MedicalHistory, UpdateSourceTrigger=PropertyChanged}" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />
                </StackPanel>
            </Border>

            <!-- Sidebar -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Node Operations" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20" />
                        <Button Content="REGISTER PATIENT" Style="{StaticResource PrimaryButtonStyle}" Height="50" Margin="0,0,0,12" Command="{Binding SaveCommand}" />
                        <Button Content="CLEAR BUFFER" Style="{StaticResource ActionButtonStyle}" Height="40" Margin="0,0,0,12" Command="{Binding NewFormCommand}" />
                        <Button Content="DISCARD" Style="{StaticResource DeleteActionButtonStyle}" Height="40"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="CustomersList" />
                    </StackPanel>
                </Border>
                
                <Border Style="{StaticResource ModernCard}" Background="#0AFFFFFF">
                    <StackPanel>
                        <TextBlock Text="Privacy Compliance" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="Patient data is encrypted end-to-end. Ensure contact details are accurate for medication alerts." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
