<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Forms.BillingForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AddLineCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding CreateSalesBillCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveLineCommand}" />
        <KeyBinding Key="D" Modifiers="Control+Shift" Command="{Binding QuickAddDoctorCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Content="← BACK" Style="{StaticResource ActionButtonStyle}" Width="90" Height="36" VerticalAlignment="Top"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="BillingList" />
                
                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="Clinical Billing Terminal" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Execute complex pharmacological transactions and insurance-compliant billing." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Line Entry & DataGrid -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Medication Dispensing Entry" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20" />
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Search Medication / Active Batch" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <TextBox Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="System Quantity" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                                <TextBox Text="{Binding LineQty}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dispense Rate" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,0,0,4" />
                                <TextBox Text="{Binding LineRate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MRP" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,0,0,4" />
                                <TextBox Text="{Binding LineMrp}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Disc%" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,0,0,4" />
                                <TextBox Text="{Binding LineDiscountPercent}" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="GST%" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,0,0,4" />
                                <TextBox Text="{Binding LineGstPercent}" />
                            </StackPanel>
                            
                            <Button Grid.Column="8" Content="ADD LINE" Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="16,0" VerticalAlignment="Bottom" Command="{Binding AddLineCommand}" />
                        </Grid>

                        <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Height="360" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medication Item" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" />
                                <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="80" />
                                <DataGridTextColumn Header="GST%" Binding="{Binding GstPercent}" Width="60" />
                                <DataGridTemplateColumn Header="Total" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Amount, StringFormat=N2}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Style="{StaticResource DeleteActionButtonStyle}" Height="22" Width="22" Padding="0" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Patient Info & Totals Sidebar -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Patient / Node Registry" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20" />
                            
                             <TextBlock Text="Patient Name" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                            <TextBlock Text="Prescription Number / Rx ID" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                            <TextBox Text="{Binding PrescriptionNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                            <TextBlock Text="Patient Contact" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CustomerMobile, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                            <TextBlock Text="Prescribing Practitioner (Search)" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,6" />
                            <TextBox Text="{Binding DoctorSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding FilteredDoctors}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedDoctorId}" Margin="0,0,0,16" />

                            <Expander Header="Quick Add Practitioner" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8">
                                <Border Background="#0AFFFFFF" CornerRadius="12" Padding="12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBox Text="{Binding QuickAddDoctorName}" Tag="Name" Margin="0,0,0,8" />
                                        <TextBox Text="{Binding QuickAddDoctorRegistrationNo}" Tag="Registration ID" Margin="0,0,0,8" />
                                        <TextBox Text="{Binding QuickAddDoctorMobile}" Tag="Mobile" Margin="0,0,0,8" />
                                        <Button Content="Commit New Dr" Command="{Binding QuickAddDoctorCommand}" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Financial Distribution" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20" />
                            
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Taxable Value" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding TaxableAmount, StringFormat=INR {0:N2}}" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Height="1" Background="White" Opacity="0.1" Margin="0,4" />
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Central Tax (CGST)" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding CgstAmount, StringFormat=INR {0:N2}}" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="State Tax (SGST)" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Text="{Binding SgstAmount, StringFormat=INR {0:N2}}" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                            </Grid>

                            <Border Background="{StaticResource AccentGradient}" CornerRadius="12" Padding="20" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="GRAND TOTAL" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" Opacity="0.8" />
                                    <TextBlock Text="{Binding EstimatedGrandTotal, StringFormat=INR {0:N2}}" Foreground="{StaticResource BrushTextPrimary}" FontSize="26" FontWeight="ExtraBold" />
                                </StackPanel>
                            </Border>

                            <Button Content="FINALIZE SALES BILL" Style="{StaticResource PrimaryButtonStyle}" Height="54" Margin="0,20,0,12" Command="{Binding CreateSalesBillCommand}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Preview PDF" Style="{StaticResource ActionButtonStyle}" Width="120" Margin="0,0,8,0" Command="{Binding PreviewCurrentInvoiceCommand}" />
                                <Button Content="External Export" Style="{StaticResource ActionButtonStyle}" Width="120" Command="{Binding ExportLastInvoicePdfCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
