<UserControl x:Class="ShopERP.Rebuild.Desktop.Views.Pages.Forms.DoctorsForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Content="← BACK" Style="{StaticResource ActionButtonStyle}" Width="90" Height="36" VerticalAlignment="Top"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="DoctorsList" />
                
                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="Practitioner Registration" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Establish clinical credentials for medical specialists." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Main Fields -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,24,0">
                <StackPanel>
                    <TextBlock Text="Professional Identity" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,24" />
                    
                    <TextBlock Text="Full Legal Name" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Practitioner License ID / Registration No" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                            <TextBox Text="{Binding RegistrationNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                            <TextBlock Text="Medical Specialization" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Specialization, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                            <TextBlock Text="Medical Degree (e.g., MBBS, MD)" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Degree, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                            <TextBlock Text="Clinic Name" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                            <TextBox Text="{Binding ClinicName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                            <TextBlock Text="Primary Practice Address" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Emergency Contact (Mobile)" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                            <TextBlock Text="Official Email Alignment" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                            <TextBlock Text="Practicing Status" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding DoctorStatusOptions}" SelectedItem="{Binding DoctorStatus}" Padding="12,10" Margin="0,0,0,20" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Clinic Hours / Visiting Details" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                    <TextBox Text="{Binding VisitDetails, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" />
                </StackPanel>
            </Border>

            <!-- Sidebar -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Node Operations" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20" />
                        <Button Content="ESTABLISH PRACTITIONER" Style="{StaticResource PrimaryButtonStyle}" Height="50" Margin="0,0,0,12" Command="{Binding SaveCommand}" />
                        <Button Content="CLEAR BUFFER" Style="{StaticResource ActionButtonStyle}" Height="40" Margin="0,0,0,12" Command="{Binding NewFormCommand}" />
                        <Button Content="DISCARD" Style="{StaticResource DeleteActionButtonStyle}" Height="40"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="DoctorsList" />
                    </StackPanel>
                </Border>
                
                <Border Style="{StaticResource ModernCard}" Background="#0AFFFFFF">
                    <StackPanel>
                        <TextBlock Text="Clinical Authority" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="Practitioners registered here will be authorized to prescribe medications within the MediCore ecosystem." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>