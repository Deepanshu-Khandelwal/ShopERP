<Window x:Class="ShopERP.Rebuild.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShopERP.Rebuild.Desktop.Converters"
        Title="MediCore Nexus // Gateway"
        Height="720"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        AllowsTransparency="False"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Border BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT ART PANEL -->
            <Border Grid.Column="0" Background="{StaticResource BrushPrimary}" CornerRadius="20,0,0,20">
                <Grid>
                    <!-- Abstract Background Pattern (Simulated) -->
                    <Canvas Opacity="0.1">
                        <Ellipse Width="400" Height="400" Fill="White" Canvas.Left="-100" Canvas.Top="-100" />
                        <Ellipse Width="300" Height="300" Fill="White" Canvas.Right="-50" Canvas.Bottom="-50" />
                    </Canvas>
                    
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="60">
                        <Border Width="80" Height="80" CornerRadius="24" Background="#33FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,32">
                            <TextBlock Text="Rx" Foreground="{StaticResource BrushOnAccent}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MEDICORE" Foreground="{StaticResource BrushOnAccent}" FontSize="48" FontWeight="ExtraBold" />
                        <TextBlock Text="ADVANCED MEDICAL ERP SYSTEM" Foreground="{StaticResource BrushOnAccent}" FontSize="16" FontWeight="Medium" Opacity="0.8" Margin="0,8,0,40" />
                        
                        <StackPanel Margin="0,20">
                            <TextBlock Text="• AI-Powered Health Insights" Foreground="{StaticResource BrushOnAccent}" FontSize="14" Margin="0,8"/>
                            <TextBlock Text="• Global Pharmacy Sync" Foreground="{StaticResource BrushOnAccent}" FontSize="14" Margin="0,8"/>
                            <TextBlock Text="• Secure End-to-End Encryption" Foreground="{StaticResource BrushOnAccent}" FontSize="14" Margin="0,8"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT LOGIN PANEL -->
            <Border Grid.Column="1" Background="{StaticResource BrushNavSurface}" CornerRadius="0,20,20,0" Padding="60">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NEXUS ACCESS" Foreground="{StaticResource BrushPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="Welcome Back" Foreground="{StaticResource BrushTextPrimary}" FontSize="32" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="Verify your identification to continue." Foreground="{StaticResource BrushTextSecondary}" FontSize="14" Margin="0,0,0,40" />

                    <!-- USERNAME -->
                    <TextBlock Text="Identification ID (Username)" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                    <TextBox x:Name="UsernameInput" Text="{Binding Username}" Margin="0,0,0,24" />

                    <!-- PASSWORD -->
                    <TextBlock Text="Secure Token (Password)" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="0,0,0,8" />
                    <PasswordBox x:Name="PasswordInput" Margin="0,0,0,12" />

                    <!-- ERROR -->
                    <Border Background="#15EF4444" CornerRadius="8" Padding="12" Margin="0,0,0,24" 
                            Visibility="{Binding Error, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource BrushDanger}" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- ACTIONS -->
                    <Button Content="ESTABLISH CONNECTION" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Height="54" 
                            IsDefault="True"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Click="OnLoginClick" />

                    <Button Content="REQUEST ACCESS (REGISTER)" 
                            Style="{StaticResource LinkButtonStyle}" 
                            HorizontalAlignment="Center" 
                            Margin="0,24,0,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Click="OnRegisterClick" />
                </StackPanel>
            </Border>
            
            <!-- Close Button -->
                    <Button Content="✕" Width="40" Height="40" Background="Transparent" Foreground="{StaticResource BrushTextPrimary}" 
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="OnCloseClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>